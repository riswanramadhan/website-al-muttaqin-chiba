# Salin ke .env.local. Semua opsional: tanpa Supabase situs memakai data seed (src/data).

# URL publik situs (dipakai sitemap, metadata, manifest)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (PRD-02). Kosongkan untuk mode seed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (PRD-07). Buat dengan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@almuttaqinculturalcenter.org
# Rahasia untuk /api/push/send; dipakai penjadwal luar (cron-job.org) tiap 5 menit, lihat README
PUSH_CRON_SECRET=

# Cloudflare Turnstile anti-spam (PRD-10). Kosong = form tetap bisa dikirim tanpa verifikasi.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend untuk notifikasi email ke pengurus
RESEND_API_KEY=
NOTIFY_EMAIL_TO=

# YouTube Data API untuk deteksi live (opsional). Tanpa ini, embed live_stream dipakai.
YOUTUBE_API_KEY=
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=

# Feature flag jalur donasi otomatis (Midtrans / Stripe), PRD-05
PAYMENT_GATEWAY_ENABLED=false

# Rahasia untuk /api/revalidate
REVALIDATE_SECRET=

# Salin ke .env.local. Semua opsional: tanpa Supabase situs memakai data seed (src/data).

# URL publik situs (dipakai sitemap, metadata, manifest)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (PRD-02). Kosongkan untuk mode seed / panel admin mode demo.
# Ambil dari Supabase Dashboard > Project Settings > API. Sebelum mengisi, jalankan
# supabase/setup-all.sql di SQL Editor (skema, data awal, dan akun admin pertama).
NEXT_PUBLIC_SUPABASE_URL=
# Kunci publik: isi salah satu. ANON_KEY = kunci lama (JWT "anon public"); PUBLISHABLE_KEY = kunci baru (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role (RAHASIA, hanya di server): dipakai untuk Web Push dan mengundang admin baru.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (PRD-07). Buat dengan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@almuttaqinculturalcenter.org
# Rahasia untuk /api/push/send; dipakai penjadwal luar (cron-job.org) tiap menit, lihat README
PUSH_CRON_SECRET=
# Interval pemicu dalam menit (bawaan 1). Isi 5 bila penjadwal hanya bisa tiap 5 menit.
PUSH_CRON_INTERVAL_MIN=

# Cloudflare Turnstile anti-spam (PRD-10). Kosong = form tetap bisa dikirim tanpa verifikasi.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend untuk notifikasi email ke pengurus
RESEND_API_KEY=
NOTIFY_EMAIL_TO=

# YouTube Data API untuk deteksi live (opsional). Tanpa ini, embed live_stream dipakai.
YOUTUBE_API_KEY=
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=

# Feature flag jalur donasi otomatis (Midtrans / Stripe), PRD-05
PAYMENT_GATEWAY_ENABLED=false

# Rahasia untuk /api/revalidate (opsional). Panel admin sudah menyegarkan situs sendiri; endpoint
# ini hanya untuk pemicu dari luar, mis. Database Webhook Supabase.
REVALIDATE_SECRET=
